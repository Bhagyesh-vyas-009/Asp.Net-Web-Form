<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="DUMaster.master.cs" Inherits="WebsiteWithMasterPage.Content.DUMaster" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-LN+7fdVzj6u52u30Kp6M/trliBMCMKTyK833zpbD+pXdCLuTusPj697FH4R/5mcr" crossorigin="anonymous">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js" integrity="sha384-ndDqU0Gzau9qJ1lfW4pNLlhNTkCfHzAVBReH9diLvGRem5+R9g2FzA8ZGN954O5Q" crossorigin="anonymous"></script>

    <asp:ContentPlaceHolder ID="cphHead" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <div class="container-fluid">
            <div class="row header">
                <div class="col-3">
                    <asp:Image ID="imgDULogo" runat="server" SkinId="SkinimgDULogo" />
                </div>
                <div class="col-9 ">
                    <h1 class="col-12 text-end">Darshan University</h1>
                    <h5 class="col-12 text-end">Rajkot - Morbi Highway,Gujarat-363650, INDIA</h5>
                    <div class="col-12 text-end">
                        <nav class="navbar navbar-expand-lg float-end">
                            <div class="container-fluid">
                                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                                        <li class="nav-item">
                                            <asp:HyperLink ID="hlHome" class="nav-link active" runat="server">Home</asp:HyperLink>
                                        </li>
                                        <li class="nav-item">
                                            <asp:HyperLink ID="hlAbout" class="nav-link active" runat="server" NavigateUrl="~/DUWebsite/AboutUs.aspx">About</asp:HyperLink>
                                        </li>
                                        <li class="nav-item">
                                            <asp:HyperLink ID="hlPrograms" class="nav-link active" runat="server">Programs</asp:HyperLink>
                                        </li>
                                        <li class="nav-item">
                                            <asp:HyperLink ID="hlPlacements" class="nav-link active" runat="server">Placements</asp:HyperLink>
                                        </li>
                                        <li class="nav-item">
                                            <asp:HyperLink ID="hlContactUs" class="nav-link active" runat="server" NavigateUrl="~/DUWebsite/ContactUs.aspx">Contact Us</asp:HyperLink>
                                        </li>
                                        <li class="nav-item dropdown">
                                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Dropdown
                                            </a>
                                            <ul class="dropdown-menu">
                                                <li><a class="dropdown-item" href="#">Action</a></li>
                                                <li><a class="dropdown-item" href="#">Another action</a></li>
                                                <li>
                                                    <hr class="dropdown-divider">
                                                </li>
                                                <li><a class="dropdown-item" href="#">Something else here</a></li>
                                            </ul>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </nav>
                    </div>
                </div>
            </div>
            <hr />
            <div class="row">
                <asp:ContentPlaceHolder ID="cphMainContent" runat="server">
                </asp:ContentPlaceHolder>
            </div>
            <hr class="text-danger" />
            <div class="row text-center">
                <footer>
                    Darshan University &copy;2025
                </footer>
            </div>
        </div>
        <div>
        </div>
    </form>
</body>
</html>
